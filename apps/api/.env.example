# Environment
NODE_ENV=development
PORT=3000

# Database (docker compose defaults)
DATABASE_URL=postgresql://quizrush:quizrush@localhost:5432/quizrush?schema=public

# Redis (optional — in-memory fallback if unreachable)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=quiz-rush-dev-secret-change-me
JWT_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*
